{
  "name": "heyquilt",
  "version": "0.3.7",
  "description": "Real-time, tool-agnostic pair vibe coding: sync a project folder live between collaborators using any AI coding tool.",
  "author": {
    "name": "Daniel Carmichael",
    "url": "https://heyquilt.com"
  },
  "type": "module",
  "bin": {
    "quilt": "bin/quilt.js",
    "cowove": "bin/quilt.js"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "serve": "node bin/quilt.js serve",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icons": "electron desktop/make-icons.cjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@supabase/supabase-js": "^2.117.2",
    "chokidar": "^5.0.0",
    "fast-diff": "^1.3.0",
    "ignore": "^7.0.10",
    "jose": "^6.2.12",
    "lib0": "^0.2.118",
    "node-diff3": "^3.2.1",
    "nodemailer": "^10.0.12",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "RELEASES.md"
  ],
  "main": "desktop/main.js",
  "build": {
    "appId": "dev.quilt.app",
    "productName": "Quilt",
    "copyright": "MIT License",
    "directories": {
      "buildResources": "desktop/build",
      "output": "dist"
    },
    "files": [
      "bin/**",
      "src/**",
      "assets/**",
      "desktop/main.js",
      "desktop/preload.cjs",
      "desktop/updater.js",
      "desktop/icons/*.png",
      "package.json",
      "RELEASES.md"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "quilt invite",
        "schemes": [
          "quilt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "quilt-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Quilt",
      "artifactName": "quilt-mac-${arch}.${ext}",
      "background": "desktop/build/background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 215,
          "type": "file"
        },
        {
          "x": 480,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "quilt-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
